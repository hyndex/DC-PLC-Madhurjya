### SECC configuration for DIN-only fallback (DC DIN 70121)
NETWORK_INTERFACE=eth1
PROTOCOLS=DIN_SPEC_70121
SECC_SAP_PREFER_EV_PRIORITY=0
SECC_ENFORCE_TLS=False
# EIM only for NO_TLS sessions
AUTH_MODES=EIM
LOG_LEVEL=INFO
# Reduce library message logging overhead
MESSAGE_LOG_JSON=0
MESSAGE_LOG_EXI=0
# Include timestamp fields in SessionSetupRes (some EVs expect it)
SECC_INCLUDE_TIMESTAMP=1
# Duplicate resend + decode tolerances
V2G_DUPLICATE_RESEND_ENABLED=1
V2G_DUPLICATE_RESEND_WINDOW_S=2.0
V2G_DUPLICATE_RESEND_MAX=3
V2G_MAX_DECODE_ERRORS=5
V2G_MAX_EXI_BYTES=262144
V2G_MAX_EXI_JSON_BYTES=1048576
# Provide a DIN EVSEID in hexBinary form (10 nibbles typically). Example corresponds to 49*89*6360
# You can override at runtime with EVSE_ID_DIN_HEX or EVSE_ID_DIN (star format)
EVSE_ID_DIN_HEX=49A89A6360
