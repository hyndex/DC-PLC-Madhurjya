### SECC configuration (DIN-first preference; robust ISO handling)
# Network interface is still overridden by CLI to eth1; keep here for completeness
NETWORK_INTERFACE=eth1

# Protocol preference: DIN first (as requested), then ISO 15118-2, then -20
PROTOCOLS=DIN_SPEC_70121,ISO_15118_2,ISO_15118_20_DC,ISO_15118_20_AC

# Force EVSE order (DIN first) instead of honoring EV priority
SECC_SAP_PREFER_EV_PRIORITY=0
SECC_ENFORCE_TLS=False

# Robustness controls for noisy PLC conditions
V2G_DUPLICATE_RESEND_ENABLED=1
V2G_DUPLICATE_RESEND_WINDOW_S=2.0
V2G_DUPLICATE_RESEND_MAX=3
V2G_MAX_DECODE_ERRORS=5
V2G_MAX_EXI_BYTES=262144
V2G_MAX_EXI_JSON_BYTES=1048576

# Logging detail inside iso15118 package
LOG_LEVEL=INFO

# EVSE identity (ISO 15118 EVSEID format: CC*XXX*ID*Z). Adjust to your installation.
# Example below is for India; update as needed to a registered EVSE ID.
EVSE_ID=INJPSE0006360

# Restrict to EIM auth in NO_TLS sessions for simplicity (PnC requires TLS)
AUTH_MODES=EIM
# Reduce library message logging overhead
MESSAGE_LOG_JSON=0
MESSAGE_LOG_EXI=0
# Include timestamp fields in SessionSetupRes (some EVs expect it)
SECC_INCLUDE_TIMESTAMP=1

# --- DC fast-path tuning and echo shaping ---
# Build CurrentDemandRes from EV targets (bounded) and pre-commit hardware
EVSE_ECHO_CURRENTDEMAND=1
# Minimum current to report while module is latching (A) and floor as fraction of EV request
EVSE_ECHO_I_FLOOR_A=1.0
EVSE_ECHO_I_FLOOR_FRAC=0.05
# Hardware envelopes (used for both echo and setpoint caps)
EVSE_ECHO_I_MAX_A=200
EVSE_ECHO_P_MAX_W=30000
# Prefer immediate combined V/I apply via ESP dc.set; skip slew limiting
EVSE_FAST_HARD_APPLY=1
# Dispatch HAL setpoints asynchronously to free the encoding path
EVSE_FAST_ASYNC_HAL=1
# Tiny wait to let ESP latch setpoints before encoding CurrentDemandRes (ms). Set 0 if close to 250 ms budget.
EVSE_CD_PRECOMMIT_WAIT_MS=15

# ESP peripheral configuration defaults (makes ramp predictable)
EVSE_PERIPH_CFG_V_MIN=150
EVSE_PERIPH_CFG_V_MAX=1000
EVSE_PERIPH_CFG_I_MAX=200
EVSE_PERIPH_CFG_P_KW=30
EVSE_PERIPH_CFG_RAMP_V=300
EVSE_PERIPH_CFG_RAMP_I=100

# Loosen steady-state tolerances and give a short grace to settle
SECC_STEADY_V_TOL_FRAC=0.15
SECC_STEADY_I_TOL_FRAC=0.15
# Approx two CD cycles grace at 80–200 ms cadence
SECC_MISMATCH_GRACE_S=0.4
SECC_MISMATCH_ABORT_S=2.0

# Make CP sticky during CurrentDemand to avoid spurious demotion A/B due to noise
EVSE_CP_STICKY_MS=600

# Reduce log noise in PreCharge and CurrentDemand phases to keep loop <250 ms
LOG_LEVEL=WARNING
