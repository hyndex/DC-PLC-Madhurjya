### PySLAC configuration
# Interface is provided by the launcher; include timeouts and robustness tuning here.

# Generous SLAC init timeout (seconds)
SLAC_INIT_TIMEOUT=50.0

# Request/response timeouts (seconds) for HomePlug requests during ATTEN/CHAR
SLAC_REQ_TIMEOUT_S=1.0
SLAC_RESP_TIMEOUT_S=1.0

# EV attenuation results timeout override (milliseconds). EV maximum is 1200 ms.
# We allow a little cushion, but keep within spec order of magnitude.
SLAC_ATTEN_RESULTS_TIMEOUT=1000
